{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultimate PPTX Slide IR",
  "type": "object",
  "required": [
    "deck"
  ],
  "properties": {
    "deck": {
      "type": "object",
      "required": [
        "id",
        "size",
        "slides"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "size": {
          "type": "object",
          "required": [
            "w",
            "h"
          ],
          "properties": {
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "objects"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "role",
                    "box",
                    "z",
                    "editability",
                    "render_policy"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "text",
                        "shape",
                        "chart",
                        "table",
                        "icon",
                        "image",
                        "group",
                        "rasterIsland",
                        "vectorIsland"
                      ]
                    },
                    "role": {
                      "type": "string"
                    },
                    "box": {
                      "type": "object",
                      "required": [
                        "x",
                        "y",
                        "w",
                        "h"
                      ],
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "w": {
                          "type": "number"
                        },
                        "h": {
                          "type": "number"
                        }
                      }
                    },
                    "z": {
                      "type": "number"
                    },
                    "editability": {
                      "type": "object",
                      "required": [
                        "level",
                        "priority",
                        "user_can_edit"
                      ],
                      "properties": {
                        "level": {
                          "enum": [
                            "text",
                            "data",
                            "style",
                            "replaceable",
                            "locked"
                          ]
                        },
                        "priority": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 5
                        },
                        "user_can_edit": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "render_policy": {
                      "enum": [
                        "native",
                        "vector",
                        "raster",
                        "hybrid"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}